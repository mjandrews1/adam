project Adam is
   for Source_Dirs use ("src/");
   for Object_Dir use "obj/";
   for Exec_Dir use "bin/";
   for Main use ("main.adb");

   package Compiler is
      for Switches ("Ada") use ("-O2", "-gnata", "-gnatwa");
   end Compiler;

   package Linker is
      for Switches ("Ada") use ();
   end Linker;
end Adam;
